

# ── Generic LLM config (preferred) 
# These are the new generic names. When set, they take precedence over the
# legacy QWEN_* variables below.
LLM_API_KEY="your_api_key"
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_MODEL="qwen-vl-plus-latest"

# ── Generic Embedding config 
# Falls back through LLM_* then QWEN_* if unset.
EMBEDDING_API_KEY="your_api_key"
EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
EMBEDDING_MODEL="text-embedding-v4"
EMBEDDING_DIMENSIONS="1024"

# ── Generic TTS config 
# Falls back through DASHSCOPE_* then QWEN_* if unset.
TTS_API_KEY="your_api_key"
TTS_MODEL="cosyvoice-v3-flash"
TTS_VOICE="longanyang"
TTS_WEBSOCKET_URL="wss://dashscope.aliyuncs.com/api-ws/v1/inference"


